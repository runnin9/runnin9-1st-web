{
  "appId": "com.runnin9.runner",
  "appName": "Runnin9",
  "webDir": "www",
  "backgroundColor": "#1a1b2e",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#1a1b2e"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#1a1b2e"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#1a1b2e"
    }
  }
}
